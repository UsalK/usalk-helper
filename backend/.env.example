# Usalk Art House Backend Environment Variables Example

# Etsy API Credentials (V3)
ETSY_CLIENT_ID=your_etsy_client_id
ETSY_CLIENT_SECRET=your_etsy_client_secret
ETSY_REDIRECT_URI=http://localhost:3001/api/etsy/callback

# AI / Kimi API credentials
NVIDIA_API_KEY=your_nvidia_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Shopify Credentials
SHOPIFY_SHOP=your_shop.myshopify.com
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
